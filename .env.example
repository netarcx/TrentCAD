# FrameCAD desktop — local dev environment.
# Copy this file to `.env` (which is gitignored) and fill in your values.
# `src/main/load-env.ts` loads `.env` at startup, so `npm run dev` picks
# these up automatically — no need to re-export them in every shell.
# A real shell `export` still takes precedence over anything here.

# Google Drive storage backend (see docs/google-workspace-setup.md).
# OAuth "Desktop app" client credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-here

# Optional: comma-separated Google Shared Drive IDs FrameCAD is allowed
# to list, join, sync, and publish. Leave blank for local dev against
# any Shared Drive your Google account can access.
FRAMECAD_GOOGLE_SHARED_DRIVE_IDS=0AExampleSharedDriveId
