# Copy to `.env` and fill in real values before `docker compose up`.
#
# The `:?` markers in docker-compose.yml mean compose will refuse to
# start if any required variable below is missing — so it's safe to
# leave the optional ones unset, but the required ones MUST be set.

# ── REQUIRED ────────────────────────────────────────────────────────

# Symmetric HMAC secret used to sign LFS auth tokens. The team server
# signs with it; the giftless container verifies with the same value.
# Generate one with: openssl rand -hex 32
LFS_JWT_SECRET=

# ── OPTIONAL ────────────────────────────────────────────────────────

# Public-facing URL of the LFS server as enrolled clients see it.
# Defaults to http://localhost:42131 which only works for the operator
# running compose on their own machine — change to the host's LAN IP
# or DNS name for any real deployment. NO trailing slash.
# LFS_SERVER_URL=http://framecad.school.local:42131
