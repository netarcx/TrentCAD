# Copy to `.env` if you want to override any defaults before
# `docker compose up`. Every variable here is OPTIONAL — the FrameCAD
# team server boots a working single-team instance with no .env at all.
#
# The team server stores team identity, locks, and publish history in a
# local SQLite database. It does NOT store CAD files — those live in your
# team's Google Shared Drive (see ../docs/google-workspace-setup.md).

# ── OPTIONAL ────────────────────────────────────────────────────────

# TCP port the server listens on.
# PORT=42130

# Bind address. Default 0.0.0.0 (LAN-facing by design).
# HOST=0.0.0.0

# Where SQLite + the setup-PIN file live. In Docker this is the mounted
# /data volume; for local dev it defaults to ./data next to the source.
# DATA_DIR=/data

# Pino log level (fatal | error | warn | info | debug | trace).
# LOG_LEVEL=info
