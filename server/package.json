{
  "name": "framecad-server",
  "version": "1.0.0-rc.3",
  "description": "Self-hosted team-coordination server for FrameCAD",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:ui": "npm --prefix ui run dev",
    "build": "npm run build:ui && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p .",
    "build:ui": "npm --prefix ui ci --no-audit --no-fund && npm --prefix ui run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose up -d --build"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/static": "^8.0.0",
    "better-sqlite3": "^11.5.0",
    "argon2": "^0.41.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
